{
  "name": "castian-a-quiet-world",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx src/systems/state.test.ts && node --import tsx src/systems/puzzles.test.ts",
    "test:e2e": "node scripts/smoke.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
